---
import Layout from '../layouts/Layout.astro';
import Sculpture from './Sculpture.astro';
import ProjectArt from './ProjectArt.astro';
import Contact from './Contact.astro';
import Icon from './Icon.astro';
import {
  copy,
  edition,
  projects,
  experience,
  profile,
  workUrl,
  type Locale,
} from '../data/portfolio';
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = copy[lang],
  e = edition[lang];
const toolkit = [
  ['Frontend', 'React / Next.js / Angular / React Native / TypeScript'],
  [
    lang === 'en' ? 'Backend & Data' : 'Backend y datos',
    'Node.js / Fastify / Express / Elixir / PostgreSQL / Prisma',
  ],
  [
    lang === 'en' ? 'Architecture & Quality' : 'Arquitectura y calidad',
    lang === 'en'
      ? 'Modular design / Hexagonal architecture / Vitest / Playwright'
      : 'Diseño modular / Arquitectura hexagonal / Vitest / Playwright',
  ],
  [
    lang === 'en' ? 'Infrastructure' : 'Infraestructura',
    'Docker / AWS / Redis / BullMQ / Git',
  ],
];
---

<Layout lang={lang}>
  <section class="hero container">
    <div class="hero-meta">
      <span class="eyebrow">
        <span class="blue-dot"></span>
        {t.role}
      </span>
      <span class="mono">LEÓN, MX · {new Date().getFullYear()}</span>
    </div>
    <div class="hero-stage">
      <h1 aria-label="Carlos Martínez">
        <span class="name-line">
          <span data-hero-line>CARLOS</span>
        </span>
        <span class="name-line last-name">
          <span data-hero-line>
            MARTÍNEZ<span class="name-period">.</span>
          </span>
        </span>
      </h1>
      <div class="hero-sculpture">
        <Sculpture id="hero" lang={lang} />
        <div class="sculpture-coordinate mono">
          <span>01—03</span>
          <span>{e.heroNote}</span>
        </div>
      </div>
      <span class="hero-vertical mono">{e.approach}</span>
    </div>
    <div class="hero-bottom">
      <div class="hero-statement">
        <span class="little-arrow" aria-hidden="true">
          ↳
        </span>
        <p>{e.heroHeadline}</p>
      </div>
      <div class="hero-description">
        <p>{e.heroSub}</p>
        <div class="hero-buttons">
          <a class="button button-blue magnetic" href="#work">
            {t.viewWork}
            <Icon name="diagonal" />
          </a>
          <a
            class="button button-text"
            href={`/cv/carlos-martinez-${lang}.pdf`}
            download
          >
            {t.resume}
            <Icon name="download" />
          </a>
        </div>
      </div>
      <a class="scroll-cue" href="#approach" aria-label={t.scroll}>
        <span>↓</span>
      </a>
    </div>
  </section>
  <section id="approach" class="approach-section">
    <div class="container process-shell">
      <div class="process-top">
        <span class="eyebrow">01 / {e.processLabel}</span>
        <h2 data-reveal-lines>{e.processTitle}</h2>
        <p>{e.processIntro}</p>
      </div>
      <div class="process-body">
        <div class="process-object">
          <Sculpture id="process" lang={lang} />
          <div class="process-notation mono">
            <span>
              {e.layers.map((layer) => layer.title.toUpperCase()).join(' → ')}
            </span>
            <span class="blue-dot"></span>
          </div>
        </div>
        <div class="process-layers">
          {e.layers.map((layer, i) => (
            <article class="process-layer" data-layer={i}>
              <div class="layer-heading">
                <span class="mono">0{i + 1}</span>
                <h3>{layer.title}</h3>
                <span class="layer-plus" aria-hidden="true">
                  +
                </span>
              </div>
              <div class="layer-details">
                <h4>{layer.subtitle}</h4>
                <p>{layer.text}</p>
                <span class="mono">{layer.tools}</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
  <section id="work" class="work-section container">
    <div class="section-intro">
      <div>
        <span class="eyebrow">02 / {t.selected}</span>
        <h2 data-reveal-lines>{e.workTitle}</h2>
      </div>
      <div>
        <span class="mono">{e.workCount}</span>
        <p>{t.workDescription}</p>
      </div>
    </div>
    <div class="projects-list">
      {projects.map((project) => (
        <article class="project-card" data-project={project.slug}>
          <div class="project-heading">
            <span class="project-number mono">/{project.number}</span>
            <a href={workUrl(lang, project.slug)} class="project-name-link">
              <h3 style={`view-transition-name: project-title-${project.slug}`}>
                {project.name}
              </h3>
              <Icon name="diagonal" />
            </a>
            <span class="project-category mono">{project[lang].category}</span>
          </div>
          <a
            class="project-visual"
            href={workUrl(lang, project.slug)}
            style={`view-transition-name: project-art-${project.slug}`}
          >
            <ProjectArt slug={project.slug} lang={lang} />
            <span class="sr-only">
              {t.readCase}: {project.name}
            </span>
            <span class="project-open magnetic">
              <Icon name="diagonal" />
            </span>
          </a>
          <div class="project-bottom">
            <p>{project[lang].summary}</p>
            <div class="project-tags">
              {project.tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
            <a
              class="project-read text-link"
              href={workUrl(lang, project.slug)}
            >
              {t.readCase}
              <Icon name="diagonal" />
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section id="experience" class="experience-section">
    <div class="container experience-grid">
      <div class="experience-intro">
        <span class="eyebrow">03 / {t.experience}</span>
        <h2 data-reveal-lines>{t.experienceTitle}</h2>
        <span class="experience-range mono">
          2023 — {new Date().getFullYear()}
          <Icon name="diagonal" />
        </span>
      </div>
      <div class="timeline">
        <div class="timeline-track" aria-hidden="true">
          <span></span>
        </div>
        {experience[lang].map((job) => (
          <article class="timeline-item">
            <span class="timeline-dot" aria-hidden="true"></span>
            <div class="job-meta mono">
              <span>{job.date}</span>
              <span>{job.mode}</span>
            </div>
            <h3>{job.company}</h3>
            <span class="job-role">{t.role}</span>
            <p>{job.text}</p>
            <div class="job-tags">
              {job.tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section id="about" class="about-section container">
    <div class="about-grid">
      <div>
        <span class="eyebrow">04 / {t.about}</span>
        <h2 data-reveal-lines>{e.aboutHeading}</h2>
        <div class="about-monogram" aria-hidden="true">
          <span>c</span>
          <span>m</span>
          <i>✳</i>
        </div>
      </div>
      <div class="about-content">
        <p>{t.aboutText}</p>
        <p>{t.aboutText2}</p>
        <div class="education">
          <Icon name="code" />
          <div>
            <strong>{t.education}</strong>
            <span>{t.university}</span>
          </div>
        </div>
        <p class="languages mono">{t.languages}</p>
      </div>
    </div>
    <div class="toolkit">
      <span class="eyebrow">{t.toolkit}</span>
      <div class="skills-grid">
        {toolkit.map(([title, tools], i) => (
          <div class="skill-item">
            <span class="mono">0{i + 1} /</span>
            <h3>{title}</h3>
            <p>{tools}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="writing-section container">
    <div class="writing-art" aria-hidden="true">
      <div class="writing-hex hex-one"></div>
      <div class="writing-hex hex-two"></div>
      <div class="writing-hex hex-three"></div>
      <span>{'{ }'}</span>
      <small class="mono">DOMAIN / PORTS / ADAPTERS</small>
    </div>
    <div class="writing-copy">
      <span class="eyebrow">{t.writing}</span>
      <h2 data-reveal-lines>{t.articleTitle}</h2>
      <p>{t.articleDescription}</p>
      <a
        class="text-link"
        href={profile.article[lang]}
        target="_blank"
        rel="noopener noreferrer"
      >
        {t.articleLink}
        <Icon name="diagonal" />
      </a>
    </div>
  </section>
  <Contact lang={lang} />
</Layout>
